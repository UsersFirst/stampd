# Copy to contracts/.env and fill in. Never commit the real file.

# Deployer key. Only needs enough ETH to cover the deployment itself; it holds no
# ongoing role, since every event carries its own signer.
DEPLOYER_PRIVATE_KEY=0x

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# For `forge script --verify`. An Etherscan V2 key from etherscan.io works on Base and
# Base Sepolia both; there is no separate Basescan key.
ETHERSCAN_API_KEY=
